<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.peerline-manager</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/REPLACE_ME/.local/bin/peerline-manager</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>RUST_LOG</key>
    <string>info</string>
    <!-- Canonical defaults are used when unset: uds /tmp/peerline-manager.sock,
         WS 127.0.0.1:6466, dashboard 127.0.0.1:6467. Uncomment to override,
         e.g. expose on a LAN or disable a transport with `off`.
    <key>PEERLINE_MANAGER_WS</key>  <string>0.0.0.0:6466</string>
    <key>PEERLINE_MANAGER_UI</key>  <string>0.0.0.0:6467</string> -->
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/REPLACE_ME/Library/Logs/peerline-manager.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/REPLACE_ME/Library/Logs/peerline-manager.log</string>
</dict>
</plist>
